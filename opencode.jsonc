{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "node .github/scripts/pr-review-sync.mjs *", "effect": "allow" },
    { "action": "shell", "resource": "node .github/scripts/pr-review-collect.mjs *", "effect": "allow" },
    { "action": "shell", "resource": "node --check .github/scripts/pr-review-sync.mjs", "effect": "allow" },
    { "action": "shell", "resource": "node --check .github/scripts/pr-review-collect.mjs", "effect": "allow" }
  ]
}
